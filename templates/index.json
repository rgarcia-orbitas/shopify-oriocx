    "e403bfd0-7d0d-45bb-8f7e-0278dbae8deb": {
      "type": "image-with-text",
      "blocks": {
        "template--19847431586119__e403bfd0-7d0d-45bb-8f7e-0278dbae8deb-heading-1": {
          "type": "heading",
