ow-2"],"settings":{"enable_sticky_info":true,"gallery_layout":"thumbnail_slider","media_size":"large","mobile_thumbnails":"show","hide_variants":true,"enable_video_looping":false,"padding_top":36,"padding_bottom":12}},"031d3605-df79-4552-a923-656ef55b68b1":{"type":"video","settings":{"heading":"","cover_image":"shopify:\/\/shop_images\/Captura_de_pantalla_2023-07-05_092913.jpg","video_url":"https:\/\/vimeo.com\/842407069","description":"","full_width":true,"color_scheme":"background-1","padding_top":8,"padding_bottom":8}},"1646042734ba033e42":{"type":"rich-text","blocks":{"1646042734a0659e8a-1":{"type":"text","settings":{"text":""}},"1646042734a0659e8a-0":{"type":"heading","settings":{"heading":"Evita el sobrecalentamiento y las ampollas","heading_size":"h1"}}},"block_order":["1646042734a0659e8a-1","1646042734a0659e8a-0"],"settings":{"color_scheme":"background-1","full_width":true,"padding_top":40,"padding_bottom":52}},"1644854849ecf13122":{"type":"image-with-text","blocks":{"16448548492e70806f-0":{"type":"heading","settings":{"heading":"","heading_size":"h1"}},"16448548492e70806f-1":{"type":"text","settings":{"text":"<p>Esta zapatilla cuenta con un diseño textil que permite una transpiración muy elevada del pie; lo que favorece un secado rápido del sudor y evita el mal olor en verano. Su textil no absorbe el agua, por lo que evitamos la humedad y nos permite llevarlas puestas para bañarnos en el mar o en los ríos: secado rápido.<\/p><p>Además; hemos incluido nuestro sistema “Shark-Drain System®\" en la suela, permitiendo tanto desalojar todo el agua que entra en la zapatilla como refrigerar tus pies en ambientes secos.<\/p><p>Zapatilla ideal para disfrutar del verano tanto en la playa como en la montaña en días calurosos.<\/p>","text_style":"body"}}},"block_order":["16448548492e70806f-0","16448548492e70806f-1"],"settings":{"image":"shopify:\/\/shop_images\/shark-drain-color-negro.jpg","height":"adapt","desktop_image_width":"medium","layout":"image_first","desktop_content_position":"top","desktop_content_alignment":"left","content_layout":"no-overlap","color_scheme":"background-1","mobile_content_alignment":"left","padding_top":0,"padding_bottom":0}},"16449183565507ec91":{"type":"image-with-text","blocks":{"16449183564a700b91-0":{"type":"heading","settings":{"heading":"Máximo agarre y durabilidad en todo tipo de terrenos","heading_size":"h1"}},"16449183564a700b91-1":{"type":"text","settings":{"text":"<p>Suela con tacos con 4 mm de espesor para ganar tracción en terrenos húmedos o de montaña. El diseño de la suela permite una mejor flexión y torsión para adaptarse mejor a cualquier tipo de terreno. <\/p><p>El caucho de su suela contiene una composición desarrollada por Oriocx que ofrece un gran agarre en terrenos húmedos. Su gran durabilidad hará que puedas utilizar las zapatillas a diario sin notar desgaste.<\/p><p>El diseño de los tacos y la suela permite su uso mixto tanto en ciudad como en pistas de montaña. Además, al ser una zapatilla pensada para su uso en agua, te permitirá llevarla en tus excursiones a las calas o zonas de playa.<\/p>","text_style":"body"}}},"block_order":["16449183564a700b91-0","16449183564a700b91-1"],"settings":{"image":"shopify:\/\/shop_images\/suela-color-negro.jpg","height":"adapt","desktop_image_width":"medium","layout":"text_first","desktop_content_position":"top","desktop_content_alignment":"left","content_layout":"no-overlap","color_scheme":"background-1","mobile_content_alignment":"left","padding_top":0,"padding_bottom":0}},"16449125685dc0fb32":{"type":"image-with-text","blocks":{"1644912568723d30da-0":{"type":"heading","settings":{"heading":"Sistemas de ajuste rápido","heading_size":"h1"}},"1644912568723d30da-1":{"type":"text","settings":{"text":"<p>Podrás utilizar esta zapatilla sin llevar calcetines gracias a su diseño. Además, podrás introducir el pie de forma rápida y segura gracias a su sistema de cordones de atado rápido y a su estructura elástica textil en la zona del empeine.<\/p><p>Este diseño 100% textil lo combinamos con protecciones de PU en la zona del empeine y el talón. Esto permite una mejor estabilidad del pie y un mayor confort al no sufrir movimientos involuntarios.<\/p><p>Además, estas protecciones se encuentran también en la puntera para alargar la vida útil de la zapatilla; protegiéndote de cualquier impacto o rozadura en esas zonas.<\/p>","text_style":"body"}}},"block_order":["1644912568723d30da-0","1644912568723d30da-1"],"settings":{"image":"shopify:\/\/shop_images\/SISTEMA-DE-ATADO-RAPIDO.jpg","height":"adapt","desktop_image_width":"medium","layout":"image_first","desktop_content_position":"top","desktop_content_alignment":"left","content_layout":"no-overlap","color_scheme":"background-1","mobile_content_alignment":"left","padding_top":36,"padding_bottom":36}},"16449410662a7742f8":{"type":"apps","blocks":{"e8fd8792-e17d-4e10-b233-04365372902e":{"type":"shopify:\/\/apps\/judge-me-reviews\/blocks\/review_widget\/61ccd3b1-a9f2-4160-9fe9-4fec8413e5d8","settings":{}}},"block_order":["e8fd8792-e17d-4e10-b233-04365372902e"],"settings":{"include_margins":true}},"product-recommendations":{"type":"product-recommendations","disabled":true,"settings":{"heading":"También te puede interesar","color_scheme":"background-1","image_ratio":"square","show_secondary_image":true,"show_vendor":false,"show_rating":false,"padding_top":12,"padding_bottom":12}}},"order":["main","031d3605-df79-4552-a923-656ef55b68b1","1646042734ba033e42","1644854849ecf13122","16449183565507ec91","16449125685dc0fb32","16449410662a7742f8","product-recommendations"]}